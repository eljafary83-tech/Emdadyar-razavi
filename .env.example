# ============================================================================
# .env.example
# این فایل را در ریشه پروژه به نام ".env" کپی کرده و مقادیر واقعی را وارد کنید.
# فایل .env هرگز نباید در Git commit شود (در .gitignore قرار دارد).
# ============================================================================

# کلید API معتبر Anthropic (الزامی)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# نام مدل زبانی مورد استفاده برای تولید پاسخ (اختیاری)
# در صورت عدم تنظیم، مقدار پیش‌فرض داخل utils/generator.py استفاده می‌شود.
# برای دیدن آخرین مدل‌های در دسترس به مستندات رسمی Anthropic مراجعه کنید:
# https://docs.claude.com
ANTHROPIC_MODEL_NAME=claude-sonnet-4-5
