# ============================================================================
# .env.example
# این فایل را در ریشه پروژه به نام ".env" کپی کرده و مقادیر واقعی را وارد کنید.
# فایل .env هرگز نباید در Git commit شود (در .gitignore قرار دارد).
# ============================================================================

# قرارداد API پیش‌فرض، chat-completions سازگار با OpenAI است. هیچ مقدار واقعی
# در این فایل قرار ندهید. در صورت خالی‌بودن، برنامه با پیام کنترل‌شده اجرا می‌شود.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# بازیابی فقط نتیجه‌هایی با شباهت بالاتر از این مقدار را به LLM ارسال می‌کند.
RETRIEVAL_THRESHOLD=0.42
RETRIEVAL_TOP_K=5
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=900
CHUNK_OVERLAP=140
MIN_CHUNK_LENGTH=60
